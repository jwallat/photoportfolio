# Copy to .env and adjust. Docker Compose reads .env automatically.

# Absolute path to the photos folder on the host (required)
PHOTOS_PATH=/path/to/your/photos

# Shown in the header and the browser tab
SITE_TITLE=Photo Portfolio

# Footer links; leave empty to hide them. Without both, the page has no footer.
IMPRESSUM_URL=
PRIVACY_URL=

# Image to run; defaults to ghcr.io/jwallat/photoportfolio:latest
# IMAGE=ghcr.io/<owner>/photoportfolio:latest
